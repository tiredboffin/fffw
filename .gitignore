.env.local
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so
*.o
*.elf
*.map
.vscode/

#Ghidra
*.gdt
*.out

build/
downloads/
samples/
dumps/
